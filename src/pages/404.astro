---
import Base from '../layouts/Base.astro';
---
<Base lang="en" page="404" title="Page not found · Sam Services LLC" noindex>
  <section class="wrap nf">
    <p class="kicker mono">404</p>
    <h1 class="h2">This page does not exist. <span lang="es">Esta página no existe.</span></h1>
    <p><a class="btn btn-dark" href="/">Go home</a> <a class="btn btn-dark" href="/es/" lang="es">Ir al inicio</a></p>
  </section>
</Base>
<style>
  .nf { padding-block: 120px; display: flex; flex-direction: column; gap: 20px; }
  .nf span { display: block; color: var(--muted-2); }
  .nf p:last-child { display: flex; gap: 12px; flex-wrap: wrap; }
</style>
