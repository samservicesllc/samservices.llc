---
import '../styles/global.css';
import { t, paths, SITE, EMAIL, LINKEDIN_COMPANY, LINKEDIN_PERSON, type Lang } from '../i18n';
// Fonts used by the first screen (headline, body, buttons, mono labels), preloaded so the hero
// renders in its final face and nothing reflows when they arrive
import fontDisplay from '../fonts/zilla-slab-latin-700-normal.woff2?url';
import fontBody from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import fontMono from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import fontBold from '../fonts/ibm-plex-sans-latin-600-normal.woff2?url';

interface Props {
  lang: Lang;
  page: 'home' | 'projects' | 'case' | 'casePaellas' | 'casePbx' | 'privacy' | 'terms' | 'sms' | 'accessibility' | 'integrations' | 'software' | 'phone' | 'email' | 'web' | 'servers' | '404';
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
}
const { lang, page, title, description, noindex = false, ogImage } = Astro.props;
const ogUrl = new URL((ogImage ?? t[lang].og) + '?v=4', SITE).href;
const c = t[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
const self = page === '404' ? null : paths[lang][page];
const alt = page === '404' ? paths[other].home : paths[other][page];
const home = paths[lang].home;
const pageTitle = title ?? c.title;
const desc = description ?? c.description;
const canonical = self ? new URL(self, SITE).href : undefined;
const year = new Date().getFullYear();
const menuLabel = lang === 'es' ? 'Menú' : 'Menu';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE}/#org`,
      name: 'Sam Services LLC',
      url: `${SITE}/`,
      logo: `${SITE}/icon-512.png`,
      image: `${SITE}/og-en.png`,
      email: EMAIL,
      foundingDate: '2019-02-01',
      founder: { '@id': `${SITE}/#founder` },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Naples',
        addressRegion: 'FL',
        postalCode: '34109',
        addressCountry: 'US',
      },
      areaServed: [
        { '@type': 'Country', name: 'United States' },
        ...['Naples', 'Estero', 'Bonita Springs', 'Fort Myers', 'Cape Coral', 'Marco Island'].map((name) => ({ '@type': 'City', name, containedInPlace: { '@type': 'State', name: 'Florida' } })),
      ],
      knowsLanguage: ['es', 'en'],
      sameAs: [LINKEDIN_COMPANY],
      description: t.en.description,
    },
    {
      '@type': 'Person',
      '@id': `${SITE}/#founder`,
      name: 'Arieskien Mendoza Guerra',
      jobTitle: 'Founder',
      worksFor: { '@id': `${SITE}/#org` },
      sameAs: [LINKEDIN_PERSON],
    },
  ],
};
---
<!doctype html>
<html lang={c.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="preload" href={fontDisplay} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={fontBody} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={fontMono} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={fontBold} as="font" type="font/woff2" crossorigin />
  <title>{pageTitle}</title>
  <meta name="description" content={desc} />
  {noindex && <meta name="robots" content="noindex" />}
  {canonical && <link rel="canonical" href={canonical} />}
  {page !== '404' && (
    <>
      <link rel="alternate" hreflang="es" href={new URL(paths.es[page as 'home'], SITE).href} />
      <link rel="alternate" hreflang="en" href={new URL(paths.en[page as 'home'], SITE).href} />
      <link rel="alternate" hreflang="x-default" href={new URL(paths.en[page as 'home'], SITE).href} />
    </>
  )}
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FFFFFF" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0B0F14" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Sam Services LLC" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={desc} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:secure_url" content={ogUrl} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content="Sam Services LLC" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={c.locale} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogUrl} />
  {page === 'home' && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">{c.skip}</a>
  <header class="site-header">
    <div class="wrap bar">
      <a href={home} class="brand" aria-label="Sam Services LLC">
        <picture>
          <source media="(prefers-color-scheme: dark)" srcset="/img/logo-dark-237.webp 237w, /img/logo-dark.webp 474w" sizes="(max-width: 860px) 198px, 237px" />
          <img src="/img/logo.webp" srcset="/img/logo-237.webp 237w, /img/logo.webp 474w" sizes="(max-width: 860px) 198px, 237px" alt="Sam Services LLC" width="237" height="36" />
        </picture>
      </a>
      <nav aria-label={lang === 'es' ? 'Principal' : 'Main'}>
        <a class="nl" href={`${home}#proyectos`}>{c.nav.projects}</a>
        <a class="nl" href={`${home}#servicios`}>{c.nav.services}</a>
        <a class="nl" href={`${home}#calculadora`}>{c.nav.calc}</a>
        <a class="nl" href={`${home}#nosotros`}>{c.nav.about}</a>
        <a class="lang" href={alt} hreflang={other} lang={other} aria-label={c.switchLabel}>{c.switchText}</a>
        <a class="btn btn-dark cta" href={`${home}#contacto`}>{c.nav.cta}</a>
        <details class="menu">
          <summary class="menu-btn" aria-label={menuLabel}>
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path class="l1" d="M4 7h16"/><path class="l2" d="M4 12h16"/><path class="l3" d="M4 17h16"/></svg>
          </summary>
          <div id="mnav" class="mnav">
            <div class="wrap mnav-in">
              <a href={`${home}#proyectos`}>{c.nav.projects}</a>
              <a href={paths[lang].projects}>{c.footer.projects}</a>
              <a href={`${home}#servicios`}>{c.nav.services}</a>
              <a href={`${home}#calculadora`}>{c.nav.calc}</a>
              <a href={`${home}#nosotros`}>{c.nav.about}</a>
              <a class="btn btn-blue" href={`${home}#contacto`}>{c.nav.cta}</a>
            </div>
          </div>
        </details>
      </nav>
    </div>
  </header>
  <script>
    // The menu is a native <details> (works without JS); this only adds closing conveniences
    const menu = document.querySelector('.menu') as HTMLDetailsElement | null;
    const btn = menu?.querySelector('summary') as HTMLElement | null;
    if (menu && btn) {
      const close = () => { menu.open = false; };
      menu.querySelector('.mnav')!.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) close(); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu.open) { close(); btn.focus(); }
      });
      document.addEventListener('click', (e) => {
        if (menu.open && !(e.target as Element).closest('.site-header')) close();
      });
      document.querySelector('.site-header')!.addEventListener('focusout', (e) => {
        const next = (e as FocusEvent).relatedTarget as Element | null;
        if (menu.open && next && !next.closest('.site-header')) close();
      });
      matchMedia('(min-width: 861px)').addEventListener('change', (m) => { if (m.matches) close(); });
    }
  </script>
  <main id="main">
    <slot />
  </main>
  <footer class="site-footer">
    <nav class="wrap foot-svc" aria-label={c.footer.services}>
      <span class="foot-k">{c.footer.services}</span>
      {(['web', 'software', 'integrations', 'phone', 'email', 'servers'] as const).map((k) => <a href={paths[lang][k]}>{c.footer[k]}</a>)}
    </nav>
    <div class="wrap foot">
      <span>© {year} Sam Services LLC · {c.footer.rights}</span>
      <span>
        <a href={LINKEDIN_COMPANY} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only">{lang === 'es' ? ' (se abre en una pestaña nueva)' : ' (opens in a new tab)'}</span></a> ·
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a> ·
        <a href={paths[lang].projects}>{c.footer.projects}</a> ·
        <a href={paths[lang].privacy}>{c.footer.privacy}</a> ·
        <a href={paths[lang].terms}>{c.footer.terms}</a> ·
        <a href={paths[lang].sms}>{c.footer.sms}</a> ·
        <a href={paths[lang].accessibility}>{c.footer.accessibility}</a>
      </span>
    </div>
  </footer>
</body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 20;
    background: var(--header-bg);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
    backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--border);
    view-transition-name: site-header;
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 12px; }
  .brand picture { display: block; }
  .brand img { display: block; height: 36px; width: auto; }
  nav { display: flex; align-items: center; gap: 24px; font-size: 15px; font-weight: 500; }
  .nl { color: var(--text); text-decoration: none; position: relative; }
  .nl::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -4px; height: 2px;
    background: var(--blue); transform: scaleX(0); transform-origin: left; transition: transform .2s ease;
  }
  .nl:hover { color: var(--text); }
  .nl:hover::after { transform: scaleX(1); }
  .lang {
    font-family: var(--mono); font-size: 13px; color: var(--text-2); text-decoration: none;
    border: 1px solid var(--border-strong); border-radius: 6px; padding: 6px 10px;
  }
  .lang:hover { border-color: var(--blue); color: var(--text); }
  .cta { padding: 10px 16px; font-size: 15px; }
  .menu { display: none; }
  .menu-btn { list-style: none; }
  .menu-btn::-webkit-details-marker { display: none; }
  .menu-btn {
    display: inline-flex; width: 44px; height: 44px; margin-right: -8px; padding: 0;
    align-items: center; justify-content: center; border: 0; border-radius: 8px;
    background: transparent; color: var(--text); cursor: pointer;
  }
  .menu-btn path { transition: transform .2s ease, opacity .2s ease; transform-origin: 12px 12px; }
  .menu[open] .l1 { transform: translateY(5px) rotate(45deg); }
  .menu[open] .l2 { opacity: 0; }
  .menu[open] .l3 { transform: translateY(-5px) rotate(-45deg); }
  .mnav {
    position: absolute; left: 0; right: 0; top: 100%;
    background: var(--surface); border-bottom: 1px solid var(--border);
    box-shadow: 0 14px 28px rgba(11,15,20,.10);
  }
  .mnav-in { display: flex; flex-direction: column; padding-block: 8px 20px; }
  .mnav-in a:not(.btn) {
    display: flex; align-items: center; min-height: 48px; color: var(--text);
    text-decoration: none; font-weight: 500; font-size: 17px; border-bottom: 1px solid var(--border);
  }
  .mnav-in .btn { margin-top: 16px; align-self: flex-start; }
  @media (max-width: 860px) {
    .nl { display: none; }
    nav { gap: 10px; }
    .brand img { height: 30px; }
    .menu { display: block; }
    .lang { min-height: 44px; min-width: 44px; display: inline-flex; align-items: center; justify-content: center; }
  }
  @media (max-width: 520px) {
    .cta { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .menu-btn path { transition: none; } }
  .site-footer { border-top: 1px solid var(--border); }
  .foot-svc {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 18px;
    padding-block: 22px 0; font-size: 14px;
  }
  .foot-k { font-family: var(--mono); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--text-3); }
  .foot-svc a { color: var(--text-2); }
  .foot-svc a:hover { color: var(--link-hover); }
  .foot {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px;
    padding-block: 26px; font-size: 14px; color: var(--text-3);
  }
</style>
