---
// Animated "neural constellation" background: drifting nodes, faint links,
// and light pulses that travel between connected nodes.
// Canvas 2D, ~2 KB, pauses off-screen / hidden tab, static under reduced motion.
interface Props { density?: number; class?: string }
const { density = 1, class: cls = '' } = Astro.props;
---
<canvas class:list={['neural', cls]} data-density={density} aria-hidden="true"></canvas>

<script>
  type Node = { x: number; y: number; vx: number; vy: number; r: number; tw: number };
  type Pulse = { a: number; b: number; t: number; speed: number };

  const BLUE = '0,153,255';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Phones and tablets: fewer nodes and half the frame rate (the drift is slow, 30 fps reads the same)
  const light = matchMedia('(pointer: coarse)').matches;
  const FRAME = light ? 1000 / 30 : 0;
  // The first frame is drawn still; motion starts on the first interaction or after 4 s,
  // so the page is visually settled while it loads.
  let armed = false;
  const starters: (() => void)[] = [];
  const arm = () => { if (armed) return; armed = true; starters.forEach((f) => f()); };
  ['pointermove', 'pointerdown', 'scroll', 'keydown', 'touchstart'].forEach((ev) => addEventListener(ev, arm, { once: true, passive: true }));
  setTimeout(arm, 4000);

  function start(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const host = canvas.parentElement as HTMLElement;
    const density = Number(canvas.dataset.density || 1);
    let w = 0, h = 0, dpr = 1, nodes: Node[] = [], pulses: Pulse[] = [];
    let linkDist = 140, running = false, raf = 0, last = 0, onScreen = false;
    const mouse = { x: -9999, y: -9999 };

    function resize() {
      const rect = host.getBoundingClientRect();
      w = rect.width; h = rect.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      canvas.style.width = w + 'px'; canvas.style.height = h + 'px';
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      linkDist = w < 640 ? 115 : 160;
      const count = Math.round(Math.min(110, Math.max(28, (w * h) / 10000)) * density * (light ? 0.65 : 1));
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * w, y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.12, vy: (Math.random() - 0.5) * 0.12,
        r: Math.random() * 1.4 + 0.6, tw: Math.random() * Math.PI * 2,
      }));
      pulses = [];
      draw(0);
    }

    function spawnPulse() {
      for (let tries = 0; tries < 12; tries++) {
        const a = (Math.random() * nodes.length) | 0;
        const n = nodes[a];
        const near: number[] = [];
        nodes.forEach((m, i) => {
          if (i !== a && Math.hypot(m.x - n.x, m.y - n.y) < linkDist) near.push(i);
        });
        if (near.length) {
          pulses.push({ a, b: near[(Math.random() * near.length) | 0], t: 0, speed: 0.6 + Math.random() * 0.7 });
          return;
        }
      }
    }

    function draw(dt: number) {
      ctx!.clearRect(0, 0, w, h);
      const time = performance.now() / 1000;
      // move
      for (const n of nodes) {
        n.x += n.vx * dt * 0.06; n.y += n.vy * dt * 0.06;
        if (n.x < -20) n.x = w + 20; else if (n.x > w + 20) n.x = -20;
        if (n.y < -20) n.y = h + 20; else if (n.y > h + 20) n.y = -20;
      }
      // links
      ctx!.lineWidth = 0.9;
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const d2 = dx * dx + dy * dy;
          if (d2 > linkDist * linkDist) continue;
          const d = Math.sqrt(d2);
          const mx = (a.x + b.x) / 2 - mouse.x, my = (a.y + b.y) / 2 - mouse.y;
          const near = Math.max(0, 1 - Math.hypot(mx, my) / 220);
          const alpha = (1 - d / linkDist) * (0.32 + near * 0.4);
          ctx!.strokeStyle = `rgba(${BLUE},${alpha.toFixed(3)})`;
          ctx!.beginPath(); ctx!.moveTo(a.x, a.y); ctx!.lineTo(b.x, b.y); ctx!.stroke();
        }
      }
      // nodes
      for (const n of nodes) {
        const tw = 0.55 + 0.45 * Math.sin(time * 1.3 + n.tw);
        const near = Math.max(0, 1 - Math.hypot(n.x - mouse.x, n.y - mouse.y) / 200);
        ctx!.fillStyle = `rgba(${near > 0.05 ? BLUE : '170,205,235'},${(0.35 + 0.45 * tw + near * 0.4).toFixed(3)})`;
        ctx!.beginPath(); ctx!.arc(n.x, n.y, n.r + near * 1.2, 0, Math.PI * 2); ctx!.fill();
      }
      // pulses (sparks travelling along links)
      for (let k = pulses.length - 1; k >= 0; k--) {
        const p = pulses[k];
        p.t += (dt / 1000) * p.speed;
        const a = nodes[p.a], b = nodes[p.b];
        if (p.t >= 1 || !a || !b) {
          // occasionally chain to a neighbour so signals "travel" through the network
          if (p.t >= 1 && Math.random() < 0.55) {
            const near: number[] = [];
            nodes.forEach((m, i) => { if (i !== p.b && i !== p.a && Math.hypot(m.x - b.x, m.y - b.y) < linkDist) near.push(i); });
            if (near.length) { pulses[k] = { a: p.b, b: near[(Math.random() * near.length) | 0], t: 0, speed: p.speed }; flash(b.x, b.y); continue; }
          }
          if (b) flash(b.x, b.y);
          pulses.splice(k, 1);
          continue;
        }
        const x = a.x + (b.x - a.x) * p.t, y = a.y + (b.y - a.y) * p.t;
        // bright segment of the link
        ctx!.strokeStyle = `rgba(${BLUE},0.55)`; ctx!.lineWidth = 1.2;
        ctx!.beginPath(); ctx!.moveTo(a.x, a.y); ctx!.lineTo(x, y); ctx!.stroke();
        glow(x, y, 9, 0.9);
      }
      for (let k = flashes.length - 1; k >= 0; k--) {
        const f = flashes[k]; f.life -= dt / 600;
        if (f.life <= 0) { flashes.splice(k, 1); continue; }
        glow(f.x, f.y, 16 * (1.4 - f.life * 0.4), f.life * 0.8);
      }
    }

    const flashes: { x: number; y: number; life: number }[] = [];
    function flash(x: number, y: number) { flashes.push({ x, y, life: 1 }); }
    function glow(x: number, y: number, r: number, a: number) {
      const g = ctx!.createRadialGradient(x, y, 0, x, y, r);
      g.addColorStop(0, `rgba(220,240,255,${a})`);
      g.addColorStop(0.35, `rgba(${BLUE},${a * 0.6})`);
      g.addColorStop(1, `rgba(${BLUE},0)`);
      ctx!.fillStyle = g; ctx!.beginPath(); ctx!.arc(x, y, r, 0, Math.PI * 2); ctx!.fill();
    }

    let spawnAcc = 0;
    function loop(ts: number) {
      if (FRAME && last && ts - last < FRAME - 1) { if (running) raf = requestAnimationFrame(loop); return; }
      const dt = Math.min(50, ts - (last || ts)); last = ts;
      spawnAcc += dt;
      const every = w < 640 ? 700 : 380;
      if (spawnAcc > every && pulses.length < 14) { spawnAcc = 0; spawnPulse(); }
      draw(dt);
      if (running) raf = requestAnimationFrame(loop);
    }
    function play() { if (reduce || running || !armed) return; running = true; last = 0; raf = requestAnimationFrame(loop); }
    function pause() { running = false; cancelAnimationFrame(raf); }

    host.addEventListener('pointermove', (e) => {
      const r = host.getBoundingClientRect(); mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
    });
    host.addEventListener('pointerleave', () => { mouse.x = mouse.y = -9999; });
    new ResizeObserver(() => resize()).observe(host);
    new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; onScreen && !document.hidden ? play() : pause(); }).observe(host);
    document.addEventListener('visibilitychange', () => (document.hidden || !onScreen ? pause() : play()));
    starters.push(() => { if (onScreen && !document.hidden) play(); });
    resize();
    if (reduce) { for (let i = 0; i < 3; i++) spawnPulse(); pulses.forEach((p) => (p.t = 0.5)); draw(0); }
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas.neural').forEach(start);
</script>

<style>
  .neural { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; z-index: 0; }
</style>
